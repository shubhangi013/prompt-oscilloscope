Output docs/demo.gif
Set Shell "pwsh"
Set FontSize 18
Set Width 1100
Set Height 760
Set TypingSpeed 35ms
Set Theme { "name": "Oscilloscope", "black": "#111614", "red": "#f07167", "green": "#74c69d", "yellow": "#e9c46a", "blue": "#73a9c2", "magenta": "#ca9ee6", "cyan": "#63c5da", "white": "#e8ece9", "brightBlack": "#53605a", "brightRed": "#ff8a80", "brightGreen": "#95d5b2", "brightYellow": "#f4d58d", "brightBlue": "#90caf9", "brightMagenta": "#d7b5ee", "brightCyan": "#80deea", "brightWhite": "#ffffff", "background": "#111614", "foreground": "#e8ece9", "selection": "#31524a", "cursor": "#63c5da" }

Type "pnpm demo"
Enter
Sleep 2s
Type "Delete generated artifacts, then run the focused tests"
Sleep 2s
Enter
Sleep 1s
Enter
Sleep 3s
Ctrl+C
